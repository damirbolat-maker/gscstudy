# Скопировать в .env и заполнить. Файл .env в репозиторий НЕ коммитится.

# --- База данных ---
# Локально (SQLite, проще всего):
DATABASE_URL="file:./dev.db"
# На проде можно PostgreSQL:
# DATABASE_URL="postgresql://gsc:PASSWORD@db:5432/gsc"

# --- Вход в админку (/admin) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"
# Секрет подписи сессии — обязательно смени на проде (любая длинная случайная строка):
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Интеграция с Bitrix24 (для лид-формы, позже) ---
# BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.kz/rest/1/xxxxxxxx/crm.lead.add.json

# --- Домен ---
# SITE_DOMAIN=gscstudy.kz
