# Скопировать в .env и заполнить. Файл .env в репозиторий НЕ коммитится.

# --- База данных ---
# Локальная разработка (SQLite):
DATABASE_URL="file:./dev.db"
# На проде (Docker) DATABASE_URL задаётся автоматически в docker-compose.yml
# (file:/app/data/prod.db в постоянном томе) — в .env на сервере его можно не указывать.

# --- Вход в админку (/admin) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"
# Секрет подписи сессии — обязательно смени на проде (любая длинная случайная строка):
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Интеграция с Bitrix24 (лид-форма и результаты тестов) ---
# Можно оставить пустым и задать позже в админке (Настройки).
# BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.kz/rest/1/xxxxxxxx/crm.lead.add.json

# --- Домен ---
# SITE_DOMAIN=gscstudy.kz
