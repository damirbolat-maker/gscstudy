# Скопировать в .env и заполнить реальными значениями (на VPS).
# .env в репозиторий НЕ коммитится.

# --- База данных (когда подключим Prisma/Postgres) ---
# POSTGRES_PASSWORD=change-me-strong-password
# DATABASE_URL=postgresql://gsc:change-me-strong-password@db:5432/gsc

# --- Интеграция с Bitrix24 (для лид-формы) ---
# BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.kz/rest/1/xxxxxxxx/crm.lead.add.json

# --- Домен (для nginx/сертификатов) ---
# SITE_DOMAIN=gscstudy.kz
